# Copier ce fichier en .env.local (jamais commité) et remplir les valeurs.
# Sur Vercel : Project Settings › Environment Variables.

# --- Supabase (Project Settings › API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clé « publishable » (sb_publishable_…) ou, à défaut, l'ancienne clé « anon »
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : serveur uniquement (planificateur, jetons). Ne jamais l'exposer.
SUPABASE_SECRET_KEY=

# --- Accès (F-02) ---
# Adresses autorisées à se connecter, séparées par des virgules
ALLOWED_EMAILS=

# --- Site ---
# URL publique, sans barre finale (ex. https://mon-domaine.com). Sert au lien magique et aux retours OAuth.
# En local : http://localhost:3000
SITE_URL=

# --- Sécurité ---
# Clé de chiffrement des jetons OAuth : 32 octets en base64 (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
# Secret du planificateur, envoyé par pg_cron (openssl rand -hex 32)
CRON_SECRET=

# --- IA (F-37) : fournisseur par défaut (anthropic, openai ou google) et clés ---
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Meta : Facebook (pages) ---
META_APP_ID=
META_APP_SECRET=
# Version de la Graph API (ex. v27.0, dernière version au 23 nov. 2026)
META_GRAPH_VERSION=
# --- Meta : Instagram (Instagram API with Instagram Login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- LinkedIn : profils (Share on LinkedIn + OpenID Connect) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# --- LinkedIn : pages (application distincte avec Community Management API) ---
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
# Version de l'API LinkedIn (AAAAMM)
LINKEDIN_API_VERSION=

# --- X (OAuth 2.0, client confidentiel) ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Pages légales (NF-15) ---
APP_NAME=
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
# Province dont les lois s'appliquent (ex. Ontario)
LEGAL_PROVINCE=
# Date affichée « Dernière mise à jour » (AAAA-MM-JJ)
LEGAL_LAST_UPDATED=
